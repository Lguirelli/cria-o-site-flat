    {
      "id": "booking",
      "name": "Reserva",
      "slug": "reserva",
      "x": 2940,
      "y": 130,
      "width": 1200,
      "blocks": [
        {
          "id": "booking-block-0",
          "blockId": "amenities-01",
          "html": "<main><section class=\"amenities-section\" data-node=\"n1\"><div class=\"amenities-head\"><div><p class=\"eyebrow\" data-node=\"n2\">More Than Just a Place to Sleep</p><h1 data-node=\"n3\">Amenities Designed for Every<br>Kind of Traveler</h1></div><p data-node=\"n4\">Whether you’re here to relax, explore, or work remotely, we’ve thought of every detail. From beach access to local dining and concierge-style service, this stay is built to elevate your experience.</p></div><div class=\"amenities-grid\"><article class=\"amenity\" data-node=\"n5\"><span class=\"icon\" aria-hidden=\"true\">directions_boat</span><span class=\"number\" data-node=\"n6\">#01</span><h2 data-node=\"n7\">Waterfront Access</h2><p data-node=\"n8\">Easily explore nearby harbors, boat tours, or enjoy scenic views by the water.</p></article><article class=\"amenity\" data-node=\"n9\"><span class=\"icon\" aria-hidden=\"true\">hiking</span><span class=\"number\" data-node=\"n10\">#02</span><h2 data-node=\"n11\">Adventure Ready</h2><p data-node=\"n12\">Perfect base for hiking, exploring, and day trips with nature just around the corner.</p></article><article class=\"amenity\" data-node=\"n13\"><span class=\"icon\" aria-hidden=\"true\">golf_course</span><span class=\"number\" data-node=\"n14\">#03</span><h2 data-node=\"n15\">Nearby Golf Courses</h2><p data-node=\"n16\">Tee off at world-class golf courses just a short drive from your stay.</p></article><article class=\"amenity\" data-node=\"n17\"><span class=\"icon\" aria-hidden=\"true\">flight</span><span class=\"number\" data-node=\"n18\">#04</span><h2 data-node=\"n19\">Easy Airport Access</h2><p data-node=\"n20\">Quick connections with major airports for smooth arrivals and departures.</p></article><article class=\"amenity\" data-node=\"n21\"><span class=\"icon\" aria-hidden=\"true\">concierge</span><span class=\"number\" data-node=\"n22\">#05</span><h2 data-node=\"n23\">Hotel-Level Service</h2><p data-node=\"n24\">Enjoy a seamless stay with concierge-style support and thoughtful touches.</p></article><article class=\"amenity\" data-node=\"n25\"><span class=\"icon\" aria-hidden=\"true\">beach_access</span><span class=\"number\" data-node=\"n26\">#06</span><h2 data-node=\"n27\">Walk to the Beach</h2><p data-node=\"n28\">Sun, sand, and sea — just minutes away from your front door.</p></article><article class=\"amenity\" data-node=\"n29\"><span class=\"icon\" aria-hidden=\"true\">ramen_dining</span><span class=\"number\" data-node=\"n30\">#07</span><h2 data-node=\"n31\">Local Dining Spots</h2><p data-node=\"n32\">Discover top-rated restaurants, cafés, and street food within walking distance.</p></article><article class=\"amenity\" data-node=\"n33\"><span class=\"icon\" aria-hidden=\"true\">explore</span><span class=\"number\" data-node=\"n34\">#08</span><h2 data-node=\"n35\">Explore Like a Local</h2><p data-node=\"n36\">Get insider tips and curated guides to make the most of your trip.</p></article></div></section></main>"
        },
        {
          "id": "booking-block-1",
          "blockId": "amenities-02",
          "html": "<main><section class=\"booking-section\" id=\"booking\" data-node=\"n1\"><form id=\"calendar-form\"><p class=\"eyebrow\" data-node=\"n2\">Secure your dates in just a few clicks</p><h2 data-node=\"n3\">Ready to Book Your Stay?</h2><p data-node=\"n4\">Check availability, choose your dates, and reserve your perfect stay instantly. It’s fast, easy, and commitment-free until you confirm.</p><label data-node=\"n5\">Email*<input type=\"email\" name=\"email\" placeholder=\"jane@email.com\" required></label><div class=\"form-row\"><label data-node=\"n6\">First name*<input name=\"firstName\" placeholder=\"Jane\" required></label><label data-node=\"n7\">Last name*<input name=\"lastName\" placeholder=\"Smith\" required></label></div><label data-node=\"n8\">Select Start and End date*</label><div class=\"calendar-head\"><button type=\"button\" id=\"prev-month\" aria-label=\"Previous month\" data-node=\"n9\"><span class=\"icon\" aria-hidden=\"true\">chevron_left</span></button><span id=\"month-label\" class=\"serif\" data-node=\"n10\"></span><button type=\"button\" id=\"next-month\" aria-label=\"Next month\" data-node=\"n11\"><span class=\"icon\" aria-hidden=\"true\">chevron_right</span></button></div><div class=\"calendar\" id=\"calendar\"></div><p class=\"date-summary\" id=\"date-summary\" role=\"status\" data-node=\"n12\">Choose your arrival and departure dates.</p><button class=\"btn light\" type=\"submit\" data-node=\"n13\">Submit</button></form><div class=\"portrait\"><img src=\"assets/amenities-1.webp\" alt=\"Quiet wooden retreat surrounded by trees\" class=\"\" loading=\"lazy\" data-node=\"n14\"></div></section></main>"
        }
      ]
    }
