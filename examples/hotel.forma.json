        {
          "id": "home-block-0",
          "blockId": "form-01",
          "html": "<section class=\"hero\" data-node=\"n1\"><header class=\"topnav\" data-node=\"n2\"><a class=\"brand\" href=\"#\" data-node=\"n3\">FORM / RETREAT</a><nav><a href=\"#rooms\" data-node=\"n4\">Stay</a><a href=\"#rooms\" data-node=\"n5\">Eat</a><a href=\"#rooms\" data-node=\"n6\">Experience</a><a href=\"#rooms\" data-node=\"n7\">About</a><button class=\"btn \" data-book=\"\" data-node=\"n8\">Book now</button></nav></header><div class=\"hero-copy\"><h1 data-node=\"n9\">Space to<br>slow down.</h1><p data-node=\"n10\">A boutique hotel for a more<br>considered way of living.</p><a class=\"text-link\" href=\"#rooms\" data-node=\"n11\">Explore the retreat <span class=\"icon\" aria-hidden=\"true\">arrow_forward</span></a></div></section>"
        },
        {
          "id": "home-block-1",
          "blockId": "form-02",
          "html": "<main id=\"rooms\" class=\"rooms gallery3\"><article class=\"room\" data-node=\"n1\"><div class=\"room-photo\"><img src=\"assets/form-1.webp\" alt=\"The Olive Room\" class=\"\" loading=\"lazy\" data-node=\"n2\"></div><h3 data-node=\"n3\">THE OLIVE ROOM</h3><p data-node=\"n4\">Grounded, restful and filled<br>with natural light.</p><button class=\"plain text-link\" data-room=\"The Olive Room\" data-image=\"form-1\" data-node=\"n5\">View room <span class=\"icon\" aria-hidden=\"true\">arrow_forward</span></button></article><article class=\"room\" data-node=\"n6\"><div class=\"room-photo\"><img src=\"assets/form-2.webp\" alt=\"The Garden Suite\" class=\"\" loading=\"lazy\" data-node=\"n7\"></div><h3 data-node=\"n8\">THE GARDEN SUITE</h3><p data-node=\"n9\">Indoor and outdoor living<br>in harmony.</p><button class=\"plain text-link\" data-room=\"The Garden Suite\" data-image=\"form-2\" data-node=\"n10\">View room <span class=\"icon\" aria-hidden=\"true\">arrow_forward</span></button></article><article class=\"room\" data-node=\"n11\"><div class=\"room-photo\"><img src=\"assets/form-3.webp\" alt=\"The Arch Suite\" class=\"\" loading=\"lazy\" data-node=\"n12\"></div><h3 data-node=\"n13\">THE ARCH SUITE</h3><p data-node=\"n14\">Refined details, expansive views<br>and a sense of calm.</p><button class=\"plain text-link\" data-room=\"The Arch Suite\" data-image=\"form-3\" data-node=\"n15\">View room <span class=\"icon\" aria-hidden=\"true\">arrow_forward</span></button></article></main>"
        }
      ]
    },
    {
      "id": "suite",
