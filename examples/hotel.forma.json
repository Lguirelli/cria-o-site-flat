        {
          "id": "home-block-0",
          "blockId": "form-01",
          "html": "<section class=\"hero\" data-node=\"n1\"><header class=\"topnav\" data-node=\"n2\"><a class=\"brand\" href=\"#\" data-node=\"n3\">FORM / RETREAT</a><nav><a href=\"#rooms\" data-node=\"n4\">Hospedagem</a><a href=\"#rooms\" data-node=\"n5\">Gastronomia</a><a href=\"#rooms\" data-node=\"n6\">Experiências</a><a href=\"#rooms\" data-node=\"n7\">Sobre</a><button class=\"btn \" data-book=\"\" data-node=\"n8\">Reserve agora</button></nav></header><div class=\"hero-copy\"><h1 data-node=\"n9\">Espaço para<br>desacelerar.</h1><p data-node=\"n10\">Um hotel boutique para viver<br>com mais calma e propósito.</p><a class=\"text-link\" href=\"#rooms\" data-node=\"n11\">Conheça o refúgio <span class=\"icon\" aria-hidden=\"true\">arrow_forward</span></a></div></section>"
        },
        {
          "id": "home-block-1",
          "blockId": "form-02",
          "html": "<main id=\"rooms\" class=\"rooms gallery3\"><article class=\"room\" data-node=\"n1\"><div class=\"room-photo\"><img src=\"assets/form-1.webp\" alt=\"Quarto Oliveira\" class=\"\" loading=\"lazy\" data-node=\"n2\"></div><h3 data-node=\"n3\">QUARTO OLIVEIRA</h3><p data-node=\"n4\">Acolhedor, tranquilo e cheio<br>de luz natural.</p><button class=\"plain text-link\" data-room=\"Quarto Oliveira\" data-image=\"form-1\" data-node=\"n5\">Ver quarto <span class=\"icon\" aria-hidden=\"true\">arrow_forward</span></button></article><article class=\"room\" data-node=\"n6\"><div class=\"room-photo\"><img src=\"assets/form-2.webp\" alt=\"Suíte Jardim\" class=\"\" loading=\"lazy\" data-node=\"n7\"></div><h3 data-node=\"n8\">SUÍTE JARDIM</h3><p data-node=\"n9\">Ambientes internos e externos<br>em harmonia.</p><button class=\"plain text-link\" data-room=\"Suíte Jardim\" data-image=\"form-2\" data-node=\"n10\">Ver quarto <span class=\"icon\" aria-hidden=\"true\">arrow_forward</span></button></article><article class=\"room\" data-node=\"n11\"><div class=\"room-photo\"><img src=\"assets/form-3.webp\" alt=\"Suíte Arco\" class=\"\" loading=\"lazy\" data-node=\"n12\"></div><h3 data-node=\"n13\">SUÍTE ARCO</h3><p data-node=\"n14\">Detalhes refinados, vistas amplas<br>e uma sensação de tranquilidade.</p><button class=\"plain text-link\" data-room=\"Suíte Arco\" data-image=\"form-3\" data-node=\"n15\">Ver quarto <span class=\"icon\" aria-hidden=\"true\">arrow_forward</span></button></article></main>"
        }
      ]
    },
    {
      "id": "suite",
      "name": "Suíte Deluxe",
      "slug": "suite-deluxe",
      "x": 1520,
      "y": 130,
      "width": 1200,
      "blocks": [
        {
          "id": "suite-block-0",
          "blockId": "deluxe-01",
          "html": "<section class=\"hero\" data-node=\"n1\"><header class=\"topnav\" data-node=\"n2\"><a class=\"brand\" href=\"#\" data-node=\"n3\">HOTEL E SPA</a><nav><a href=\"#\" data-node=\"n4\">Início</a><a href=\"#facilities\" data-node=\"n5\">Restaurantes</a><a href=\"#details\" data-node=\"n6\">Quarto</a><a href=\"#facilities\" data-node=\"n7\">Spa</a><button class=\"btn \" data-book=\"\" data-node=\"n8\">Reserve agora</button></nav></header><div class=\"hero-copy\"><h1 data-node=\"n9\">Quarto duplo deluxe</h1><p data-node=\"n10\">Um encontro entre elegância e natureza</p><button class=\"btn \" data-book=\"Quarto duplo deluxe\" data-node=\"n11\">Reservar quarto</button></div></section>"
        },
        {
          "id": "suite-block-1",
          "blockId": "deluxe-02",
          "html": "<main><section class=\"deluxe-details\" id=\"details\" data-node=\"n1\"><div class=\"room-photo\"><img src=\"assets/deluxe-1.webp\" alt=\"Banheiro com vista para o mar\" class=\"\" loading=\"lazy\" data-node=\"n2\"><div class=\"carousel-buttons\"><button aria-label=\"Foto anterior do quarto\" data-deluxe-photo=\"-1\" data-node=\"n3\"><span class=\"icon\" aria-hidden=\"true\">chevron_left</span></button><button aria-label=\"Próxima foto do quarto\" data-deluxe-photo=\"1\" data-node=\"n4\"><span class=\"icon\" aria-hidden=\"true\">chevron_right</span></button></div></div><div><h2 data-node=\"n5\">Duplo deluxe com<br>vista para o mar</h2><p data-node=\"n6\">Um refúgio espaçoso com interiores elegantes, detalhes cuidadosos e uma vista livre para o mar.</p><div class=\"features\"><span data-node=\"n7\">54 m² de área</span><span data-node=\"n8\">Quartos conjugados</span><span data-node=\"n9\">Opções de travesseiros</span><span data-node=\"n10\">Sala de café da manhã</span></div><button class=\"btn \" data-book=\"Duplo deluxe com vista para o mar\" data-node=\"n11\">Reserve agora</button></div></section></main>"
        },
        {
          "id": "suite-block-2",
          "blockId": "deluxe-03",
          "html": "<main><section class=\"facilities\" id=\"facilities\" data-node=\"n1\"><h2 data-node=\"n2\">Comodidades do quarto</h2><p data-node=\"n3\">Serviços do quarto duplo deluxe com vista para o spa</p><div class=\"facility-grid\"><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">groups</span><p data-node=\"n4\">Atendimento VIP diário</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">bathtub</span><p data-node=\"n5\">Banheiros com ducha</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">tv</span><p data-node=\"n6\">Smart TV de 40 polegadas</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">spa</span><p data-node=\"n7\">Acesso diário ao spa</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">bed</span><p data-node=\"n8\">Preparação noturna do quarto</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">coffee</span><p data-node=\"n9\">Serviço de café e chá</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">ac_unit</span><p data-node=\"n10\">Ar-condicionado</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">lock</span><p data-node=\"n11\">Cofre</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">kitchen</span><p data-node=\"n12\">Bebidas no frigobar</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">room_service</span><p data-node=\"n13\">Serviço de quarto 24 horas</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">local_laundry_service</span><p data-node=\"n14\">Lavanderia</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">wifi</span><p data-node=\"n15\">Wi-Fi gratuito</p></div></div></section></main>"
        },
        {
          "id": "suite-block-3",
          "blockId": "deluxe-04",
          "html": "<main><section class=\"deluxe-lists\" data-node=\"n1\"><div><h3 data-node=\"n2\">Destaques da suíte</h3><ul><li>Interiores elegantes</li><li>Vistas panorâmicas</li><li>Sala de estar separada</li><li>Roupa de cama confortável</li></ul></div><div><h3 data-node=\"n3\">Serviços do hotel</h3><ul><li>Aluguel de carros e bicicletas</li><li>Lembranças e presentes</li><li>Câmbio</li><li>Traslados</li><li>Passeios disponíveis</li><li>Estacionamento VIP</li></ul></div></section></main>"
        },
        {
          "id": "suite-block-4",
          "blockId": "deluxe-05",
          "html": "<main><h3 class=\"related\" data-node=\"n1\">Outros quartos</h3></main>"
