        {
          "id": "suite-block-0",
          "blockId": "deluxe-01",
          "html": "<section class=\"hero\" data-node=\"n1\"><header class=\"topnav\" data-node=\"n2\"><a class=\"brand\" href=\"#\" data-node=\"n3\">HOTEL &amp; SPA</a><nav><a href=\"#\" data-node=\"n4\">Home</a><a href=\"#facilities\" data-node=\"n5\">Restaurants</a><a href=\"#details\" data-node=\"n6\">Room</a><a href=\"#facilities\" data-node=\"n7\">Spa</a><button class=\"btn \" data-book=\"\" data-node=\"n8\">Book now</button></nav></header><div class=\"hero-copy\"><h1 data-node=\"n9\">Double Deluxe Room</h1><p data-node=\"n10\">A blend of elegance and nature</p><button class=\"btn \" data-book=\"Double Deluxe Room\" data-node=\"n11\">Book room</button></div></section>"
        },
        {
          "id": "suite-block-1",
          "blockId": "deluxe-02",
          "html": "<main><section class=\"deluxe-details\" id=\"details\" data-node=\"n1\"><div class=\"room-photo\"><img src=\"assets/deluxe-1.webp\" alt=\"Ocean view bathroom\" class=\"\" loading=\"lazy\" data-node=\"n2\"><div class=\"carousel-buttons\"><button aria-label=\"Previous room photo\" data-deluxe-photo=\"-1\" data-node=\"n3\"><span class=\"icon\" aria-hidden=\"true\">chevron_left</span></button><button aria-label=\"Next room photo\" data-deluxe-photo=\"1\" data-node=\"n4\"><span class=\"icon\" aria-hidden=\"true\">chevron_right</span></button></div></div><div><h2 data-node=\"n5\">Double Deluxe with<br>Ocean View</h2><p data-node=\"n6\">A spacious retreat combining elegant interiors, thoughtful details and uninterrupted ocean views.</p><div class=\"features\"><span data-node=\"n7\">54 m² in size</span><span data-node=\"n8\">Connecting rooms</span><span data-node=\"n9\">Pillow Menu</span><span data-node=\"n10\">Breakfast room</span></div><button class=\"btn \" data-book=\"Double Deluxe with Ocean View\" data-node=\"n11\">Book now</button></div></section></main>"
        },
        {
          "id": "suite-block-2",
          "blockId": "deluxe-03",
          "html": "<main><section class=\"facilities\" id=\"facilities\" data-node=\"n1\"><h2 data-node=\"n2\">Room Facilities</h2><p data-node=\"n3\">Services of the Double Deluxe Spa View Room</p><div class=\"facility-grid\"><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">groups</span><p data-node=\"n4\">Daily VIP treatment</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">bathtub</span><p data-node=\"n5\">Bathrooms with shower</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">tv</span><p data-node=\"n6\">40” Smart TV</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">spa</span><p data-node=\"n7\">Daily access to the Spa</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">bed</span><p data-node=\"n8\">Evening turndown service</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">coffee</span><p data-node=\"n9\">Coffee and tea service</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">ac_unit</span><p data-node=\"n10\">Air conditioning</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">lock</span><p data-node=\"n11\">Safety deposit box</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">kitchen</span><p data-node=\"n12\">Minibar drinks</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">room_service</span><p data-node=\"n13\">24h room service</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">local_laundry_service</span><p data-node=\"n14\">Laundry service</p></div><div class=\"facility\"><span class=\"icon\" aria-hidden=\"true\">wifi</span><p data-node=\"n15\">Free wifi</p></div></div></section></main>"
        },
        {
          "id": "suite-block-3",
          "blockId": "deluxe-04",
          "html": "<main><section class=\"deluxe-lists\" data-node=\"n1\"><div><h3 data-node=\"n2\">Suite highlights</h3><ul><li>Elegant Interior Design</li><li>Panoramic Views</li><li>Separate Living Area</li><li>Comfortable Bedding</li></ul></div><div><h3 data-node=\"n3\">Hotel Services</h3><ul><li>Car &amp; Bicycle rental</li><li>Souvenir &amp; gift</li><li>Currency exchange</li><li>Transfers</li><li>Excursions available</li><li>VIP Parking</li></ul></div></section></main>"
        },
        {
          "id": "suite-block-4",
