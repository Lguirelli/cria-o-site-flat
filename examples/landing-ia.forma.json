    {
      "id": "landing-ia-hero",
      "name": "Abertura com pato amarelo",
      "slug": "landing-ia-hero",
      "x": 1600,
      "y": 130,
      "width": 1200,
      "hidden": true,
      "blocks": [
        {
          "id": "instance-landing-ia-hero",
          "blockId": "landing-ia-hero",
          "html": "<div class=\"lp-section home-page\" data-landing-section=\"hero\"><section class=\"hero hero-with-bg\" data-copy-section=\"hero\" id=\"hero\">\n  <div class=\"hero-bg-media\" aria-hidden=\"true\">\n    <picture>\n      <source media=\"(max-width: 768px)\" srcset=\"fontes/landing/assets/images/hero-mobile-bg.webp\" type=\"image/webp\">\n      <source media=\"(max-width: 768px)\" srcset=\"fontes/landing/assets/images/hero-mobile-bg.jpg\" type=\"image/jpeg\">\n      <source srcset=\"fontes/landing/assets/images/hero-desktop-bg.webp\" type=\"image/webp\">\n      <img src=\"fontes/landing/assets/images/hero-desktop-bg.jpg\" alt=\"\" loading=\"eager\" decoding=\"async\" fetchpriority=\"high\">\n    </source></source></source></picture>\n  </div>\n\n  <div class=\"hero-bg-text-shade\" aria-hidden=\"true\"></div>\n\n  <div class=\"container grid-2 hero-grid hero-grid-copy-left\">\n    <div class=\"hero-copy\">\n      <span class=\"section-kicker\" data-copy=\"hero.kicker\"> inteligência artificial, automação<br>e soluções digitais estratégicas</span>\n      <h1 class=\"hero-title\" data-copy=\"hero.title\" data-blur-text data-blur-delay=\"105\" data-blur-by=\"words\" data-blur-direction=\"top\">Transforme atendimento, conteúdo e vendas com IA e automação.</h1>\n      <p class=\"hero-lead\" data-copy=\"hero.lead\">Criamos agentes de IA, landing pages, automações e dashboards para empresas em crescimento que querem vender melhor, reduzir processos manuais e tomar decisões com mais clareza a partir do que já acontece na operação.</p>\n      <div class=\"btn-row\">\n        <a class=\"btn btn-accent\" data-copy=\"hero.primaryButton\" href=\"#lead\">Solicitar diagnóstico</a>\n        <a class=\"btn btn-secondary\" data-copy=\"hero.secondaryButton\" href=\"#how-it-works\">Ver soluções</a>\n      </div>\n    </div>\n    <div class=\"hero-empty-visual\" aria-hidden=\"true\"></div>\n  </div>\n</section>\n</div>"
        }
      ]
    },
    {
      "id": "landing-ia-trust-strip",
