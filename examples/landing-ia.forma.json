      "hidden": true,
      "blocks": [
        {
          "id": "instance-landing-ia-trust-strip",
          "blockId": "landing-ia-trust-strip",
          "html": "<div class=\"lp-section home-page\" data-landing-section=\"trust-strip\"><section aria-label=\"Guias editoriais\" class=\"section-tight\" data-copy-section=\"trust\">\n  <div class=\"container\">\n    <p class=\"section-kicker\" data-copy=\"trust.kicker\">Guias editoriais para entender atendimento, conversão, automação, dados e conteúdo com mais clareza.</p>\n    <div class=\"logo-strip blog-topic-strip\">\n      <a class=\"logo-box\" data-copy=\"trust.logo1\" href=\"fontes/landing/blog.html#atendimento\">Atendimento</a>\n      <a class=\"logo-box\" data-copy=\"trust.logo2\" href=\"fontes/landing/blog.html#conversao\">Conversão</a>\n      <a class=\"logo-box\" data-copy=\"trust.logo3\" href=\"fontes/landing/blog.html#automacao\">Automação</a>\n      <a class=\"logo-box\" data-copy=\"trust.logo4\" href=\"fontes/landing/blog.html#dados\">Dados</a>\n      <a class=\"logo-box\" data-copy=\"trust.logo5\" href=\"fontes/landing/blog.html#conteudo\">Conteúdo</a>\n      <a class=\"logo-box logo-box-accent\" data-copy=\"trust.logo6\" href=\"fontes/landing/blog.html\">Conheça todas</a>\n    </div>\n  </div>\n</section>\n</div>"
